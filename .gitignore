@"
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.expo/
dist/
*.log
*.py[cod]
.env
.ruff_cache/
.DS_Store
"@ | Out-File -Encoding utf8 .gitignore
backend/*.egg-info/

# Firebase service-account key (FCM push notifications) — sensitive private
# key, unlike google-services.json which is safe to commit. Firebase names
# this file like "<project-id>-firebase-adminsdk-xxxxx-xxxxxxxxxx.json".
*firebase-adminsdk*.json
