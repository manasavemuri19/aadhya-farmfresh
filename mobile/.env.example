# Copy to .env and point at your machine's LAN IP when testing on a real phone.
# localhost on a phone means the phone, not your laptop.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:8000/v1

# Google Sign-In client IDs (not secret — safe to see, but keep one place
# of truth). From Google Cloud Console > APIs & Services > Credentials.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps Platform key — THIS ONE IS A REAL SECRET (billed per request).
# Restrict it in Google Cloud Console to this app's package name + release
# SHA-1 before using it anywhere. Set it here for local dev only; for EAS
# builds use `eas secret:create` / `eas env:create` instead of eas.json.
GOOGLE_MAPS_API_KEY=
