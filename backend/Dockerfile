# Multi-stage: build wheels once, ship a slim runtime without a compiler.
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# AAD-OPS-005: `pip install .` against pyproject.toml's open-ended `>=`
# bounds used to resolve to whatever each dependency's latest release was
# *at build time* — the image you tested and the image a rebuild produces
# an hour later could carry different code, with no lockfile for
# `pip-audit` or Dependabot to scan. `requirements-lock.txt` is generated by
# `uv export` from `uv.lock` (regenerate both with `uv lock && uv export
# --frozen --no-emit-project --output-file requirements-lock.txt`, run from
# backend/, whenever pyproject.toml's dependencies change) and pins every
# dependency to an exact version with its sha256 hash; pip refuses the
# install outright if any downloaded file's hash doesn't match. This installs
# only the dependency set, exactly as `pip install .` did before — the app's
# own code was never built as a wheel here (there's no `app/` in this build
# context to find), it's copied into the runtime stage below as plain source.
COPY pyproject.toml requirements-lock.txt ./
RUN pip install --prefix=/install --no-deps -r requirements-lock.txt

# ---------------------------------------------------------------------------

FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/usr/local/bin:$PATH"

# Run as a non-root user. A container that never needs to write to its own
# filesystem should not be able to.
RUN groupadd --system app && useradd --system --gid app --home /app app
WORKDIR /app

COPY --from=builder /install /usr/local
COPY --chown=app:app app ./app
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini ./alembic.ini

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/v1/health/live').status==200 else 1)"

# Railway and most PaaS inject $PORT. Default to 8000 for local runs.
#
# AAD-OPS-002: migrations used to run here, inside CMD, on every boot —
# meaning on every restart and, worse, on every replica booting together.
# Alembic takes no lock of its own, so two replicas racing `alembic upgrade
# head` against the same database could produce duplicate DDL attempts or a
# partially applied migration, and a failing migration would crash-loop
# every replica with no way back. Migrations are now a gated, one-shot
# pre-deploy step instead (see railway.json's `preDeployCommand`), which
# Railway runs exactly once per deploy, before the new image is exposed to
# traffic — so this CMD only ever needs to start the server. As a second,
# cheaper-than-trusting-the-platform layer, `alembic/env.py` now also takes
# a Postgres advisory lock around the migration itself, so `alembic upgrade
# head` is safe to run concurrently even if it's ever invoked outside this
# gated path (a manual run during an incident, a different deploy target).
#
# AAD-SEC-005: this used to run with `--proxy-headers
# --forwarded-allow-ips='*'`, which told uvicorn to trust X-Forwarded-For
# from *any* source — a client that sent its own header controlled what
# request.client.host became, a complete IP forgery, and a complete bypass
# of the per-IP rate limiting AAD-SEC-004 added. Neither flag is here now:
# uvicorn no longer rewrites request.client from proxy headers at all, and
# app/core/client_ip.py resolves the real client IP itself from the
# rightmost X-Forwarded-For hop — the one Railway's own single-hop proxy
# appended, which a client cannot forge — rather than trusting a header
# uvicorn was told to accept from anyone.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
