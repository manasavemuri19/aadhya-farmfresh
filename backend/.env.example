# ---- Runtime ----
ENV=local                       # local | staging | production
LOG_LEVEL=INFO
PORT=8000

# ---- Database ----
# Paste your provider's connection string as-is. Railway, Supabase, Neon and
# RDS all give you a postgresql:// URL; the app switches it to the async
# driver internally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aadhya
SQL_ECHO=false
# Pool size/overflow default to what was previously hardcoded (10/10) — tune
# per environment instead of editing code. Statement/lock/idle timeouts are
# new; defaults are conservative and shouldn't need changing.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# ---- Auth ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- Payments ----
PAYMENT_PROVIDER=mock           # mock | razorpay
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required (no default) once PAYMENT_PROVIDER=razorpay — see AAD-OPS-009.
# Your own backend's /v1/payments/link-redirect URL, not Razorpay's.
RAZORPAY_CALLBACK_URL=

# ---- Store rules ----
CURRENCY=INR
DELIVERY_FEE_PAISE=2900
FREE_DELIVERY_THRESHOLD_PAISE=29900
MIN_ORDER_PAISE=0
# Cash-on-delivery abuse controls — see AAD-BIZ-002 in the PRR audit.
COD_MAX_ACTIVE_ORDERS_PER_USER=2
COD_MAX_ORDER_VALUE_PAISE=300000
COD_REQUIRES_PRIOR_DELIVERY=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Host header validation (AAD-SEC-017) ----
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,test,aadhya-farmfresh-production.up.railway.app
