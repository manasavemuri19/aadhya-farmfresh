# ---- Runtime ----
ENV=local                       # local | staging | production
LOG_LEVEL=INFO
PORT=8000

# ---- Database ----
# Paste your provider's connection string as-is. Railway, Supabase, Neon and
# RDS all give you a postgresql:// URL; the app switches it to the async
# driver internally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aadhya
SQL_ECHO=false

# ---- Auth ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-every-environment
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=60
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# In local/staging the OTP is returned in the API response instead of being
# sent over SMS. NEVER enable this in production.
OTP_DEBUG_ECHO=true

# ---- Payments ----
PAYMENT_PROVIDER=mock           # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Store rules ----
CURRENCY=INR
DELIVERY_FEE_PAISE=2900
FREE_DELIVERY_THRESHOLD_PAISE=29900
MIN_ORDER_PAISE=9900

# ---- CORS ----
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
